#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if ! printf '%s\n' "$staged" | grep -Eq '(^src/|^pom.xml$)'; then
  exit 0
fi

echo "pre-commit: spotless + tests"
./mvnw -q spotless:apply
./mvnw test

while IFS= read -r file; do
  if [ -n "$file" ] && [ -f "$file" ]; then
    git add -- "$file"
  fi
done <<< "$staged"
