# App
# Local only. Omit on production so the `dev` profile (demo seed, local Vehicle cap) does not run.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_PUBLIC_HOST=https://dealership.greatnerve.com
APP_LOCAL_HOST=http://localhost:8080
APP_CORS_ORIGINS=*

# JWT — ≥ 32 bytes. Production must set a unique value (not the yaml default).
APP_JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-key!!
APP_JWT_TTL=7d

# Postgres — localhost for `make run` (JVM on host → published ports).
# `make app` / `make up` remap the host to the Compose service name `postgres`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dealership
SPRING_DATASOURCE_USERNAME=dealership
SPRING_DATASOURCE_PASSWORD=dealership
POSTGRES_DB=dealership
# 0 = auto from CPU count (2× processors, 8–32). Pin to override.
HIKARI_MAX_POOL=0
HIKARI_CONNECTION_TIMEOUT=5000

# Redis — localhost for `make run`; Compose remaps host to `redis`.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# Production (Upstash): also set USERNAME, PASSWORD, SSL_ENABLED=true
# SPRING_DATA_REDIS_USERNAME=default
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_DATA_REDIS_SSL_ENABLED=true

# RabbitMQ — localhost for `make run`; Compose remaps host to `rabbitmq`.
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
# Production (CloudAMQP): port 5671, VIRTUAL_HOST, SSL_ENABLED=true
# SPRING_RABBITMQ_VIRTUAL_HOST=
# SPRING_RABBITMQ_SSL_ENABLED=true
# SPRING_RABBITMQ_PORT=5671

# Mail / Notification
# stub (default) or smtp. smtp + notify:true uses JavaMail (Brevo from these vars).
# Never commit SPRING_MAIL_PASSWORD. Put the SMTP key in local .env only.
APP_NOTIFICATIONS_MODE=stub
APP_NOTIFICATIONS_LOG_DIR=logs
APP_MAIL_FROM=dheeraj@greatnerve.com
APP_MAIL_TIMEOUT_MS=20000
APP_DELIVERY_WEBHOOK_SECRET=change-me-delivery-webhook
# Production must set a unique secret (process refuses to start if blank outside dev/test).
APP_NOTIFICATIONS_CORRELATION_HEADER=X-Mailin-custom
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false
# Brevo: APP_NOTIFICATIONS_MODE=smtp, host smtp-relay.brevo.com, port 587,
# SPRING_MAIL_USERNAME=<smtp login>, SPRING_MAIL_PASSWORD=<smtp key>,
# SPRING_MAIL_AUTH=true, SPRING_MAIL_STARTTLS=true.

# Appointment
APP_ONE_CONFIRMED_PER_VEHICLE=true

# Reminder
APP_REMINDER_OFFSETS=24h,2h
APP_NO_SHOW_GRACE=1h

# Workers
APP_WORKERS_CONCURRENCY=2
APP_WORKERS_LEASE=30s
APP_WORKERS_POLL_INTERVAL=500ms
# 0 = auto from CPUs (floor 18 for 500k Appointments/day). 1–50 to pin.
APP_WORKERS_CLAIM_BATCH=0
# 0 = auto (16× CPUs, 50–200). Pin to override.
SERVER_TOMCAT_THREADS_MAX=0

# Idempotency
APP_IDEMPOTENCY_TTL=24h

# Pagination
APP_PAGE_DEFAULT_SIZE=100
APP_PAGE_MAX_SIZE=1000
APP_PAGE_Q_MAX=100

# Rate limit (15 / 60s per endpoint)
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_LOGIN_CAPACITY=15
APP_RATE_LIMIT_LOGIN_PERIOD=60s
APP_RATE_LIMIT_CUSTOMER_CAPACITY=15
APP_RATE_LIMIT_CUSTOMER_PERIOD=60s
APP_RATE_LIMIT_STAFF_CAPACITY=15
APP_RATE_LIMIT_STAFF_PERIOD=60s
APP_RATE_LIMIT_IP_CAPACITY=15
APP_RATE_LIMIT_IP_PERIOD=60s
# Only set true behind a trusted reverse proxy. Default false so X-Forwarded-For is ignored.
APP_RATE_LIMIT_TRUST_FORWARDED_FOR=false
